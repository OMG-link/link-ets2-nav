{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nav: Check",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Check"
      ],
      "problemMatcher": []
    },
    {
      "label": "Nav: Restore",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Restore"
      ],
      "problemMatcher": []
    },
    {
      "label": "Nav: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Build"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Nav: Deploy",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Deploy"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Nav: Run",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Run"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Nav: Test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "-Action",
        "Test"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "test"
    }
  ]
}
