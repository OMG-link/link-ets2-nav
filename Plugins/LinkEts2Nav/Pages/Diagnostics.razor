@page "/link-ets2-nav"
@using LinkEts2Nav.Runtime
@using LinkEts2Nav.Core
@implements IAsyncDisposable

<style>
    .link-nav-action { cursor:pointer; border:1px solid #6b7280; border-radius:6px; padding:8px 16px; color:inherit; background:rgba(100,116,139,.16); }
    .link-nav-action:hover:not(:disabled) { background:rgba(59,130,246,.3); border-color:#60a5fa; }
    .link-nav-action:focus-visible { outline:2px solid #60a5fa; outline-offset:3px; }
    .link-nav-action:disabled { cursor:not-allowed; opacity:.5; }
</style>
<div style="padding:32px;max-width:1100px">
    <h1>Link ETS2 Nav</h1>
    <p>测速预警与基础导航 · 开发诊断</p>
    <p>@snapshot.State</p>
    <button type="button" class="link-nav-action" disabled="@previewing" @onclick="PreviewAudio">@(previewing ? "试听中…" : "试听预警音")</button>
    <p>@audioMessage</p>
    <div style="margin:16px 0">
        <label for="speech-pack-directory">预生成语音包目录</label><br />
        <input id="speech-pack-directory" type="text" @bind="speechPackDirectory" @bind:event="oninput" disabled="@savingSpeechPack"
               style="width:100%;padding:8px;border:1px solid #6b7280;border-radius:6px;background:transparent;color:inherit" />
        <p>可填写绝对路径，或相对于宿主目录的路径。目录应包含语音包清单，名称片段放在其 CityNames 子目录。</p>
        <button type="button" class="link-nav-action" disabled="@savingSpeechPack" @onclick="SaveSpeechPack">@(savingSpeechPack ? "校验并保存中…" : "保存并应用")</button>
        <p role="status">@speechPackMessage</p>
        <p>当前生效目录：@(speechPackView?.ActiveDirectory ?? "语音工作进程尚未启用")</p>
    </div>
    <div style="margin:16px 0">
        <label for="replay-comment">回放评论（可选）</label><br />
        <textarea id="replay-comment" @bind="replayComment" @bind:event="oninput" maxlength="4000"
                  disabled="@savingReplay" rows="3" style="width:100%;padding:8px;border:1px solid #6b7280;border-radius:6px;background:transparent;color:inherit" placeholder="描述刚才遇到的问题，也可以直接保存"></textarea><br />
        <button type="button" class="link-nav-action" disabled="@(savingReplay || !ReplayCapture.IsAvailable)" @onclick="SaveReplay">@(savingReplay ? "保存中…" : "保存回放")</button>
        <p role="status">@replayMessage</p>
    </div>
    <details style="margin:16px 0">
        <summary>语音使用统计</summary>
        <p>按原文累计。入队、准备和实际播放分别统计，重复规划不增加次数；回退提示音不算已播报文本。准备耗时包含工作进程请求与缓存读取，不等于纯本地推理耗时。</p>
        <label for="speech-usage-sort">排序：</label>
        <select id="speech-usage-sort" @bind="speechUsageSort"><option value="played">成功播报次数</option><option value="cost">累计准备耗时</option></select>
        <label><input type="checkbox" @bind="speechUsageCandidates" /> 仅显示已播报且当前未整句预生成的候选</label>
        <button type="button" class="link-nav-action" @onclick="RefreshSpeechUsage">刷新</button>
        <button type="button" class="link-nav-action" disabled="@(exportingSpeechUsage || SpeechUsageReports.Current is null)" @onclick="ExportSpeechUsage">@(exportingSpeechUsage?"导出中…":"导出 JSON / CSV")</button>
        <p role="status">@speechUsageMessage</p>
        @if(SpeechUsageReports.Current?.LastError is {} usageError){<p>@usageError；播放不受影响，内存统计仍可导出。</p>}
        @if(speechUsage is {} usage)
        {
            <p>累计 @usage.Entries.Count 种文本 · @usage.CollectionSessions 次收集会话 · 当前视图显示前100条；导出包含全部文本。</p>
            <table style="width:100%;text-align:left">
                <thead><tr><th>原文</th><th>入队 / 已播报</th><th>提示音 / 失败</th><th>准备次数 / 总耗时</th><th>整句预生成</th><th>首次 / 最近活动</th></tr></thead>
                <tbody>
                    @foreach(var entry in SpeechUsageRows())
                    {
                        <tr><td><details><summary>@entry.Text</summary>
                            <p>覆盖 @entry.SupersededCount · 撤销 @entry.WithdrawnCount · 重写 @entry.RewordedCount · 准备失败 @entry.PreparationFailureCount · 准备取消 @entry.PreparationCancelledCount</p>
                            <p>工作进程缓存命中 @entry.WorkerCacheHitCount · 未命中 @entry.WorkerCacheMissCount · 未知 @entry.WorkerCacheUnknownCount</p>
                            @foreach(var context in entry.Contexts){<p>@context.Source · @context.Stage · @context.EventDescription</p>}
                        </details></td><td>@entry.EnqueuedCount / @entry.PlayedCount</td><td>@entry.FallbackCount / @entry.PlaybackFailureCount</td>
                            <td>@entry.PreparationCount / @entry.PreparationMilliseconds.ToString("F0") ms</td>
                            <td>@(entry.CurrentlyPreGenerated?"是":"否")</td>
                            <td>@entry.FirstSeenAt.ToLocalTime().ToString("MM-dd HH:mm") / @entry.LastSeenAt.ToLocalTime().ToString("MM-dd HH:mm")</td></tr>
                    }
                </tbody>
            </table>
        }
    </details>
    <dl>
        <dt>路线状态</dt><dd>@snapshot.RouteState</dd>
        <dt>车辆世界坐标（X, Y, Z）</dt><dd>@(snapshot.VehiclePosition ?? "未知")</dd>
        <dt>附近探头</dt><dd>@snapshot.CameraCount</dd>
        <dt>状态更新时间</dt><dd>@(snapshot.UpdatedAt == default ? "尚未收到数据" : snapshot.UpdatedAt.ToLocalTime().ToString("HH:mm:ss"))</dd>
        <dt>最近预警</dt><dd>@(snapshot.LastWarning ?? "无")</dd>
    </dl>
    @if (snapshot.Navigation is { } navigation)
    {
        <h2>基础导航</h2>
        <p>@navigation.State</p>
        @if (navigation.Next is { } next)
        {
            <p>下一操作：@NavigationPrompts.Action(next.Kind) · 沿路 @next.DistanceMeters.ToString("F0") 米</p>
            <small>@next.Id</small>
        }
        <p>最近指令：@(navigation.LastSpoken ?? "无")</p>
    }
    @if (snapshot.TrafficLight is { } trafficLight)
    {
        <h3>信号灯实验</h3>
        <p>@trafficLight.State</p>
        <p>灯组：@(trafficLight.TargetId ?? "未知") · 相位：@trafficLight.Phase · 相位剩余：@trafficLight.Remaining · 停止线距离：@trafficLight.StopDistance · 现实秒验证：@trafficLight.ClockVerified</p>
    }
    @if (snapshot.Guidance is { } guidance)
    {
        <details>
            <summary>统一语音计划：@guidance.EventCount 个事件 · @guidance.TriggerCount 个触发点 · @guidance.Pending.Count 条待播</summary>
            <p>最近播放完成：@(guidance.LastPlayed ?? "无")</p>
            @foreach (var pending in guidance.Pending)
            { <p>待播（优先级 @pending.Priority）：@pending.Text</p> }
            <table style="width:100%;text-align:left">
                <thead><tr><th>距触发点</th><th>文案</th><th>已激活</th></tr></thead>
                <tbody>
                @foreach(var point in guidance.Upcoming.Take(20))
                { <tr><td>@point.RemainingMeters.ToString("F0") 米</td><td title="@point.TriggerId">@point.Text</td><td>@(point.Enabled ? "是" : "等待前一动作完成")</td></tr> }
                </tbody>
            </table>
            @foreach(var result in guidance.LatestTriggers)
            { <p>最近触发：@result.Trigger.Text · @result.Disposition</p> }
        </details>
    }
    @if (snapshot.LatestFine is { } fine)
    {
        <details>
            <summary>最近观测的罚单：@fine.Offence · @fine.Amount</summary>
            <p>@fine.ObservedAt.ToLocalTime().ToString("HH:mm:ss.fff") · 车辆位置 @fine.Vehicle.X.ToString("F1"), @fine.Vehicle.Y.ToString("F1"), @fine.Vehicle.Z.ToString("F1") · 朝向 @fine.Vehicle.HeadingTurns.ToString("F4") 圈</p>
            <p>这是 SDK 事件到达时的车辆位置，可能有延迟，不代表精确测速位置，也不能自动归属某个探头。</p>
        </details>
    }

    @if (snapshot.LatestCameraFine is { } cameraFine)
    {
        <p><strong>最近测速探头罚款：</strong>@cameraFine.ObservedAt.ToLocalTime().ToString("HH:mm:ss.fff") · @cameraFine.Amount · X=@cameraFine.Vehicle.X.ToString("F1"), Z=@cameraFine.Vehicle.Z.ToString("F1") · @(cameraFine.IsSignalCertain ? "已观察到罚款位翻转" : "仅字段变化，次数不确定")</p>
    }
    @if (snapshot.FineHistory is { Count: > 0 } history)
    {
        <details open>
            <summary>本会话罚款观测（保留最近 64 条，此处显示最近 12 条）</summary>
            <table style="width:100%;text-align:left">
                <thead><tr><th>时间</th><th>类型</th><th>金额</th><th>位置 X / Z</th><th>朝向（圈）</th><th>事件信号</th></tr></thead>
                <tbody>
                    @foreach (var item in history.Reverse().Take(12))
                    {
                        <tr><td>@item.ObservedAt.ToLocalTime().ToString("HH:mm:ss.fff")</td><td>@item.Offence</td><td>@item.Amount</td><td>@item.Vehicle.X.ToString("F1") / @item.Vehicle.Z.ToString("F1")</td><td>@item.Vehicle.HeadingTurns.ToString("F5")</td><td>@(item.IsSignalCertain ? "罚款位翻转" : "仅字段变化")</td></tr>
                    }
                </tbody>
            </table>
            <p>观测时间和位置可能有轮询延迟，不能自动归属探头。后续疲劳罚单不会覆盖“最近测速探头罚款”。</p>
        </details>
    }

    @if (snapshot.Cameras.Count > 0)
    {
        <table style="width:100%;text-align:left">
            <thead><tr><th>探头</th><th>挂点</th><th>直线距离</th><th>沿路距离</th><th>方向已验证</th><th>限速估算</th><th>判定</th></tr></thead>
            <tbody>
                @foreach (var camera in snapshot.Cameras)
                {
                    <tr><td><details><summary>@camera.Id</summary><p>@camera.SourceDescriptor · @camera.Variant</p><small>@camera.MetadataFingerprint</small></details></td><td>@camera.Hookup</td><td>@camera.DistanceMeters.ToString("F0") m</td><td>@(camera.RoadDistanceMeters?.ToString("F0") ?? "未知")</td><td>@(camera.DirectionVerified ? "是" : "否")</td><td title="@camera.SpeedLimitReason">@(camera.SpeedLimitKph is { } limit ? $"{limit} km/h" : "未知")<br /><small>@camera.SpeedLimitReason</small></td><td>@camera.Decision</td></tr>
                }
            </tbody>
        </table>
    }
    <p>已校准探头按路线和方向预警；未校准的有效探头仅作直线500米接近提醒，可能包括对向或邻路探头。此页面不会控制车辆或阻止罚款。</p>
    <p><a href="/plugins/manager">插件管理</a></p>
</div>

@code {
    private SpeechUsageSnapshot? speechUsage;
    private string speechUsageSort="played",speechUsageMessage="启用插件后自动收集；每30秒保存，正常停用时刷新，崩溃时最多丢失上次保存后的内存记录。";
    private bool speechUsageCandidates,exportingSpeechUsage;
    private void RefreshSpeechUsage()=>speechUsage=SpeechUsageReports.Current?.Collector.Capture();
    private IEnumerable<SpeechUsageEntry> SpeechUsageRows()
    {
        IEnumerable<SpeechUsageEntry> entries=speechUsage?.Entries??[];
        if(speechUsageCandidates)entries=entries.Where(e=>e.PlayedCount>0&&!e.CurrentlyPreGenerated);
        return(speechUsageSort=="cost"?entries.OrderByDescending(e=>e.PreparationMilliseconds).ThenByDescending(e=>e.PlayedCount)
            :entries.OrderByDescending(e=>e.PlayedCount).ThenByDescending(e=>e.PreparationMilliseconds)).Take(100);
    }
    private async Task ExportSpeechUsage()
    {
        if(exportingSpeechUsage||SpeechUsageReports.Current is not {} store)return;
        exportingSpeechUsage=true;
        try{string directory=await store.ExportAsync();speechUsageMessage="已导出全部统计："+directory;RefreshSpeechUsage();}
        catch(Exception ex){speechUsageMessage="导出失败："+ex.Message;}
        finally{exportingSpeechUsage=false;}
    }
    private bool savingSpeechPack;
    private string speechPackDirectory="";
    private string speechPackMessage="保存后自动切换，无需重启宿主；已经开始的语音允许播完。";
    private SpeechPackSettingView? speechPackView;
    private async Task SaveSpeechPack()
    {
        if(savingSpeechPack)return;
        savingSpeechPack=true;
        try
        {
            var pack=await SpeechPackSettings.Current.SaveAsync(speechPackDirectory,stop.Token);
            speechPackView=SpeechPackSettings.Current.Read();
            speechPackMessage=$"已保存，固定语音 {pack.Fixed.Count} 条、名称 {pack.Names.Count} 条。"+
                (speechPackView.ActiveDirectory is null?"启用插件语音后生效。":"正在应用；下一条语音使用新包，当前播放不打断。");
        }
        catch(OperationCanceledException)when(stop.IsCancellationRequested) { }
        catch(Exception ex){speechPackMessage="保存失败："+ex.Message;}
        finally {savingSpeechPack=false;}
    }

    private bool savingReplay;
    private string replayComment = "";
    private string replayMessage = "保存最近的滚动驾驶记录、诊断和日志；评论会一并保留。";
    private async Task SaveReplay()
    {
        if (savingReplay) return;
        savingReplay = true;
        replayMessage = "正在保存……";
        ETS2LA.Logging.Logger.Info("[[LinkEts2Nav]] 收到手动保存回放请求。");
        try
        {
            string directory = await ReplayCapture.SaveAsync(replayComment);
            replayMessage = "已保存：" + directory;
            replayComment = "";
        }
        catch (Exception ex)
        {
            replayMessage = "保存失败：" + ex.Message;
            ETS2LA.Logging.Logger.Warn("[[LinkEts2Nav]] " + replayMessage);
        }
        finally { savingReplay = false; }
    }

    private bool previewing;
    private string audioMessage = "可先试听，确认预警音在游戏中可听见。";
    private async Task PreviewAudio()
    {
        if (previewing) return;
        previewing = true;
        audioMessage = "正在提交试听请求……";
        ETS2LA.Logging.Logger.Info("[[LinkEts2Nav]] 手动试听预警音（不计为探头预警）。");
        try
        {
            var announcer = new Ets2LaWarningAnnouncer(cancellationToken: stop.Token);
            bool queued = await Task.Run(() => announcer.TryPlay(), stop.Token);
            audioMessage = queued ? "试听请求已提交；若未听到声音，请检查宿主音频设置和日志。" : "试听未能提交，请查看音频错误日志。";
            await Task.Delay(TimeSpan.FromSeconds(6), stop.Token);
        }
        catch (OperationCanceledException) { }
        finally { previewing = false; }
    }

    private NavDiagnosticSnapshot snapshot = NavDiagnostics.Current;
    private readonly CancellationTokenSource stop = new();
    private Task? refresh;

    protected override void OnInitialized()
    {
        RefreshSpeechUsage();
        try{speechPackView=SpeechPackSettings.Current.Read();speechPackDirectory=speechPackView.ConfiguredDirectory;}
        catch(Exception ex){speechPackMessage="读取语音配置失败："+ex.Message;}
        refresh=Refresh();
    }

    private async Task Refresh()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
                await InvokeAsync(() => { snapshot = NavDiagnostics.Current;
                    try{speechPackView=SpeechPackSettings.Current.Read();}catch{ }
                    StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        if (refresh is not null) await refresh;
        stop.Dispose();
    }
}
